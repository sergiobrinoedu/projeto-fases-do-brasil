# Copie para .env:  cp .env.example .env
# Banco (instruções/datasetconfig.md): MySQL · usuário root · senha root
# Porta 3307 = docker/docker-compose.yml
DATABASE_URL="mysql://root:root@127.0.0.1:3307/fases_do_brasil"

# Login com Google (Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth, tipo "Aplicativo da Web").
# Em "Origens JavaScript autorizadas" inclua http://localhost:5173 e http://localhost:3001
GOOGLE_CLIENT_ID=

PORT=3001
SESSION_DAYS=7
