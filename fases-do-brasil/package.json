{
  "name": "fases-do-brasil",
  "version": "1.0.0",
  "description": "Linha do tempo interativa 3D das fases da História do Brasil",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.js",
    "dev:all": "concurrently -k -n WEB,API -c yellow,cyan \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && node server/index.js",
    "db:init": "node scripts/db-init.js",
    "db:seed:gen": "node scripts/gen-seed.mjs",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "jquery": "^3.7.1",
    "prisma": "^7.10.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "mysql2": "^3.24.5",
    "vite": "^6.0.0"
  }
}
